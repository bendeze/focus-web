# Focus API Configuration
PROJECT_NAME="Focus & Todo API"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Security & JWT
SECRET_KEY="generate-a-secure-random-secret-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (SQLite by default, or PostgreSQL)
DATABASE_URL="sqlite:///./focus.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/focus_db"
# DATABASE_URL_POOLED="postgresql://user:password@localhost:5432/focus_db?pool_size=10"
