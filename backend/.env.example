# Focus API Configuration
PROJECT_NAME="Focus & Todo API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"  # Set to "production" in production environments

# Security & JWT - Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="generate-a-secure-random-64-char-secret-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated list or JSON array)
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]'

# Database Configuration (SQLite local dev or PostgreSQL)
DATABASE_URL="sqlite:///./focus.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/focus_db"
# DATABASE_URL_POOLED="postgresql://user:password@localhost:5432/focus_db?pool_size=10"
