# ==============================================================================
# Monorepo .gitignore: Backend, Web, and Mobile
# ==============================================================================

# --- Python & Backend ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.db
*.sqlite
*.sqlite3
focus.db
.pytest_cache/
.coverage
htmlcov/
.fastapicloud/

# --- Environment & Secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Web & Node.js ---
node_modules/
dist/
build/
.next/
.turbo/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Android & Mobile ---
.gradle/
build/
app/build/
local.properties
*.apk
*.aab
*.ap_
*.dex
.cxx/
captures/

# --- IDEs & System ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
.agents/
.gemini/
temp_git_commits.txt
web/src/services/temp*.json

